{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gale",
  "version": "0.5.0",
  "identifier": "com.faizzyhon.gale",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gale",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Muhammad Faizan",
    "copyright": "© 2026 Muhammad Faizan. MIT License.",
    "homepage": "https://github.com/faizzyhon/Gale",
    "category": "Utility",
    "shortDescription": "Free, open-source download manager for Windows",
    "longDescription": "Gale speeds up downloads with multiple connections, resumes interrupted downloads, catches downloads from Chrome and Edge, saves videos from YouTube and other sites, and organises files into categories, queues and schedules.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
