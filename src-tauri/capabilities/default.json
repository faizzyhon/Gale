{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main, per-download progress and browser pop-up windows. Opening files goes through Gale's id-based commands, not the opener plugin's JS API.",
  "windows": [
    "main",
    "download-*",
    "capture-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}