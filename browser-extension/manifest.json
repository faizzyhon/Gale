{
  "manifest_version": 3,
  "name": "Gale Download Manager",
  "short_name": "Gale",
  "version": "0.4.0",
  "description": "Send downloads, links and videos from Chrome to Gale, the free download manager for Windows.",
  "author": "Muhammad Faizan",
  "homepage_url": "https://github.com/faizzyhon/Gale",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "storage", "cookies", "webRequest", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Gale", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
